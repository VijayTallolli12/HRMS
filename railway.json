{
  "$schema": "https://railway.com/railpack.schema.json",
  "build": {
    "provider": "railpack"
  },
  "deploy": {
    "startCommand": "php artisan migrate --force && php artisan serve --host=0.0.0.0 --port=$PORT"
  },
  "railpack": {
    "providers": {
      "php": {
        "extensions": [
          "pdo",
          "pdo_mysql",
          "pdo_sqlite",
          "gd",
          "zip",
          "xml",
          "mbstring",
          "curl",
          "bcmath",
          "sockets",
          "tokenizer",
          "fileinfo",
          "exif",
          "intl",
          "dom",
          "simplexml",
          "xmlreader",
          "xmlwriter",
          "zlib",
          "iconv"
        ]
      }
    }
  }
}
